import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import {
  onchainService,
  AgentType,
  Strategy,
  RiskLevel,
  AnalysisResult,
  MarketData,
  AgentConfig
} from '../services/onchainService';

interface OnchainDashboardProps {}

export const OnchainDashboard: React.FC<OnchainDashboardProps> = () => {
  const [walletAddress, setWalletAddress] = useState<string>('');
  const [selectedAgent, setSelectedAgent] = useState<AgentType>(AgentType.YUKI);
  const [symbol, setSymbol] = useState<string>('BTC');
  const [amount, setAmount] = useState<string>('1000');
  const [loading, setLoading] = useState<boolean>(false);
  const [analysisResult, setAnalysisResult] = useState<AnalysisResult | null>(null);
  const [marketData, setMarketData] = useState<MarketData | null>(null);
  const [agentConfigs, setAgentConfigs] = useState<AgentConfig[]>([]);
  const [pendingAnalysisId, setPendingAnalysisId] = useState<string>('');

  useEffect(() => {
    loadInitialData();
    subscribeToEvents();

    return () => {
      onchainService.unsubscribeFromEvents();
    };
  }, []);

  const loadInitialData = async () => {
    try {
      // Load agent configurations
      const configs = await Promise.all([
        onchainService.getAgentConfig(AgentType.YUKI),
        onchainService.getAgentConfig(AgentType.RYU),
        onchainService.getAgentConfig(AgentType.SAKURA)
      ]);
      setAgentConfigs(configs);

      // Load market data for default symbol
      await loadMarketData(symbol);
    } catch (error) {
      console.error('Failed to load initial data:', error);
    }
  };

  const subscribeToEvents = async () => {
    await onchainService.subscribeToAnalysisEvents((event) => {
      if (event.type === 'AnalysisCompleted' && event.analysisId === pendingAnalysisId) {
        loadAnalysisResult(event.analysisId);
      }
    });
  };

  const connectWallet = async () => {
    try {
      setLoading(true);
      const address = await onchainService.connectWallet();
      setWalletAddress(address);
    } catch (error) {
      console.error('Failed to connect wallet:', error);
      alert('Failed to connect wallet. Please make sure MetaMask is installed.');
    } finally {
      setLoading(false);
    }
  };

  const loadMarketData = async (targetSymbol: string) => {
    try {
      // First update the market data
      await onchainService.updateMarketData(targetSymbol);

      // Then fetch the updated data
      const data = await onchainService.getMarketData(targetSymbol);
      setMarketData(data);
    } catch (error) {
      console.error('Failed to load market data:', error);
    }
  };

  const requestAnalysis = async () => {
    if (!walletAddress) {
      alert('Please connect your wallet first');
      return;
    }

    try {
      setLoading(true);
      setAnalysisResult(null);

      // Request analysis
      const analysisId = await onchainService.requestAnalysis(
        selectedAgent,
        symbol,
        amount
      );

      setPendingAnalysisId(analysisId);

      // Wait a moment and try to load the result
      setTimeout(async () => {
        await loadAnalysisResult(analysisId);
      }, 3000);

    } catch (error) {
      console.error('Failed to request analysis:', error);
      alert('Failed to request analysis: ' + error);
    } finally {
      setLoading(false);
    }
  };

  const loadAnalysisResult = async (analysisId: string) => {
    try {
      const result = await onchainService.getAnalysisResult(analysisId);
      if (result.isValid) {
        setAnalysisResult(result);
        setPendingAnalysisId('');
      }
    } catch (error) {
      console.error('Failed to load analysis result:', error);
    }
  };

  const updateMarketData = async () => {
    try {
      setLoading(true);
      await loadMarketData(symbol);
    } catch (error) {
      console.error('Failed to update market data:', error);
      alert('Failed to update market data');
    } finally {
      setLoading(false);
    }
  };

  const getRiskLevelColor = (riskLevel: RiskLevel): string => {
    switch (riskLevel) {
      case RiskLevel.LOW: return 'bg-green-100 text-green-800';
      case RiskLevel.MEDIUM: return 'bg-yellow-100 text-yellow-800';
      case RiskLevel.HIGH: return 'bg-orange-100 text-orange-800';
      case RiskLevel.EXTREME: return 'bg-red-100 text-red-800';
      default: return 'bg-gray-100 text-gray-800';
    }
  };

  const getStrategyColor = (strategy: Strategy): string => {
    switch (strategy) {
      case Strategy.MOMENTUM_LONG: return 'bg-green-100 text-green-800';
      case Strategy.MOMENTUM_SHORT: return 'bg-red-100 text-red-800';
      case Strategy.MEAN_REVERSION: return 'bg-blue-100 text-blue-800';
      case Strategy.YIELD_FARMING: return 'bg-purple-100 text-purple-800';
      case Strategy.ARBITRAGE: return 'bg-indigo-100 text-indigo-800';
      default: return 'bg-gray-100 text-gray-800';
    }
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
      <div className="container mx-auto p-6 space-y-6">
        <div className="text-center mb-8">
          <motion.h1
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="text-4xl font-bold text-gray-900 mb-2"
          >
            Fully Onchain AI Trading Agents
          </motion.h1>
          <p className="text-gray-600">
            Complete onchain execution with real-time market data from Chainlink and Uniswap
          </p>
        </div>

        {/* Wallet Connection */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.1 }}
          className="bg-white rounded-lg shadow-md p-6"
        >
          <h3 className="text-lg font-semibold mb-4">Wallet Connection</h3>
          {!walletAddress ? (
            <button
              onClick={connectWallet}
              disabled={loading}
              className="w-full bg-blue-600 hover:bg-blue-700 disabled:bg-gray-400 text-white font-medium py-3 px-4 rounded-lg transition-colors"
            >
              {loading ? 'Connecting...' : 'Connect Wallet'}
            </button>
          ) : (
            <div className="text-center">
              <p className="text-sm text-gray-600">Connected:</p>
              <p className="font-mono text-sm bg-gray-100 p-2 rounded">{walletAddress}</p>
            </div>
          )}
        </motion.div>

        {/* Market Data */}
        {marketData && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.2 }}
            className="bg-white rounded-lg shadow-md p-6"
          >
            <div className="flex justify-between items-center mb-4">
              <h3 className="text-lg font-semibold">Market Data - {symbol}</h3>
              <button
                onClick={updateMarketData}
                disabled={loading}
                className="bg-gray-100 hover:bg-gray-200 disabled:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm transition-colors"
              >
                Update Data
              </button>
            </div>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div>
                <p className="text-sm text-gray-600">Price</p>
                <p className="text-xl font-bold">${parseFloat(marketData.price).toFixed(6)}</p>
              </div>
              <div>
                <p className="text-sm text-gray-600">24h Volume</p>
                <p className="text-lg font-semibold">
                  ${(parseFloat(marketData.volume24h) / 1e6).toFixed(2)}M
                </p>
              </div>
              <div>
                <p className="text-sm text-gray-600">RSI</p>
                <p className="text-lg font-semibold">{marketData.rsi}</p>
              </div>
              <div>
                <p className="text-sm text-gray-600">Volatility</p>
                <p className="text-lg font-semibold">{(marketData.volatility / 100).toFixed(2)}%</p>
              </div>
            </div>
            <p className="text-xs text-gray-500 mt-2">
              Last updated: {new Date(marketData.timestamp * 1000).toLocaleString()}
            </p>
          </motion.div>
        )}

        {/* Agent Selection */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.3 }}
          className="bg-white rounded-lg shadow-md p-6"
        >
          <h3 className="text-lg font-semibold mb-4">Request Onchain Analysis</h3>
          <div className="space-y-4">
            <div>
              <label className="block text-sm font-medium mb-2">Select Agent</label>
              <div className="grid grid-cols-3 gap-2">
                {[AgentType.YUKI, AgentType.RYU, AgentType.SAKURA].map((agent, index) => (
                  <button
                    key={agent}
                    onClick={() => setSelectedAgent(agent)}
                    className={`flex flex-col items-center p-4 rounded-lg border-2 transition-all ${
                      selectedAgent === agent
                        ? 'border-blue-500 bg-blue-50 text-blue-700'
                        : 'border-gray-200 hover:border-gray-300 bg-white'
                    }`}
                  >
                    <span className="font-bold">
                      {onchainService.getAgentName(agent)}
                    </span>
                    {agentConfigs[index] && (
                      <span className="text-xs mt-1">
                        Fee: {(agentConfigs[index].analysisFeeBasisPoints / 100).toFixed(2)}%
                      </span>
                    )}
                  </button>
                ))}
              </div>
            </div>

            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium mb-2">Symbol</label>
                <input
                  type="text"
                  value={symbol}
                  onChange={(e) => setSymbol(e.target.value)}
                  placeholder="BTC, ETH, etc."
                  className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                />
              </div>
              <div>
                <label className="block text-sm font-medium mb-2">Amount (USD)</label>
                <input
                  type="number"
                  value={amount}
                  onChange={(e) => setAmount(e.target.value)}
                  placeholder="1000"
                  className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                />
              </div>
            </div>

            <button
              onClick={requestAnalysis}
              disabled={loading || !walletAddress}
              className="w-full bg-blue-600 hover:bg-blue-700 disabled:bg-gray-400 text-white font-medium py-3 px-4 rounded-lg transition-colors"
            >
              {loading ? 'Processing...' : `Request ${onchainService.getAgentName(selectedAgent)} Analysis`}
            </button>

            {pendingAnalysisId && (
              <div className="text-center text-sm text-gray-600 bg-yellow-50 p-3 rounded-lg">
                Analysis pending... ID: {pendingAnalysisId.slice(0, 10)}...
              </div>
            )}
          </div>
        </motion.div>

        {/* Analysis Result */}
        {analysisResult && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.4 }}
            className="bg-white rounded-lg shadow-md p-6"
          >
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold">
                Analysis Result - {onchainService.getAgentName(analysisResult.agent)}
              </h3>
              <span className="bg-blue-100 text-blue-800 text-sm font-medium px-2.5 py-0.5 rounded">
                Confidence: {analysisResult.confidence}%
              </span>
            </div>

            <div className="space-y-4">
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div>
                  <p className="text-sm text-gray-600">Strategy</p>
                  <span className={`inline-block px-2 py-1 rounded text-xs font-medium ${getStrategyColor(analysisResult.recommendedStrategy)}`}>
                    {onchainService.getStrategyName(analysisResult.recommendedStrategy)}
                  </span>
                </div>
                <div>
                  <p className="text-sm text-gray-600">Risk Level</p>
                  <span className={`inline-block px-2 py-1 rounded text-xs font-medium ${getRiskLevelColor(analysisResult.riskLevel)}`}>
                    {onchainService.getRiskLevelName(analysisResult.riskLevel)}
                  </span>
                </div>
                <div>
                  <p className="text-sm text-gray-600">Time Horizon</p>
                  <p className="font-semibold">
                    {onchainService.formatTimeHorizon(analysisResult.timeHorizon)}
                  </p>
                </div>
                <div>
                  <p className="text-sm text-gray-600">Risk/Reward</p>
                  <p className="font-semibold">
                    {onchainService.calculateRiskRewardRatio(
                      analysisResult.entryPrice,
                      analysisResult.targetPrice,
                      analysisResult.stopLoss
                    )}
                  </p>
                </div>
              </div>

              <div className="grid grid-cols-3 gap-4">
                <div className="text-center bg-blue-50 p-4 rounded-lg">
                  <p className="text-sm text-gray-600">Entry Price</p>
                  <p className="text-lg font-bold text-blue-600">
                    ${parseFloat(analysisResult.entryPrice).toFixed(6)}
                  </p>
                </div>
                <div className="text-center bg-green-50 p-4 rounded-lg">
                  <p className="text-sm text-gray-600">Target Price</p>
                  <p className="text-lg font-bold text-green-600">
                    ${parseFloat(analysisResult.targetPrice).toFixed(6)}
                  </p>
                  <p className="text-xs text-green-600">
                    +{onchainService.calculatePercentageChange(
                      analysisResult.entryPrice,
                      analysisResult.targetPrice
                    )}%
                  </p>
                </div>
                <div className="text-center bg-red-50 p-4 rounded-lg">
                  <p className="text-sm text-gray-600">Stop Loss</p>
                  <p className="text-lg font-bold text-red-600">
                    ${parseFloat(analysisResult.stopLoss).toFixed(6)}
                  </p>
                  <p className="text-xs text-red-600">
                    {onchainService.calculatePercentageChange(
                      analysisResult.entryPrice,
                      analysisResult.stopLoss
                    )}%
                  </p>
                </div>
              </div>

              <div className="text-center">
                <p className="text-xs text-gray-500">
                  Analysis generated: {new Date(analysisResult.timestamp * 1000).toLocaleString()}
                </p>
              </div>
            </div>
          </motion.div>
        )}

        {/* Footer */}
        <div className="text-center text-sm text-gray-500">
          <p>Powered by fully onchain AI agents with Chainlink and Uniswap V3 data feeds</p>
          <p>All analysis logic executed directly on the blockchain</p>
        </div>
      </div>
    </div>
  );
};

export default OnchainDashboard;